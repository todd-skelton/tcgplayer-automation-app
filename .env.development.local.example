# Copy this file to .env.development.local for development-only overrides.
# Dev should use the EasyPost test key.

EASYPOST_TEST_API_KEY=

# Each background job runs in the app only when its switch is set.
# Batch pricing jobs.
PRICING_WORKER=1

# The continuous pricing schedule, which queues a batch of the SKUs due for pricing.
CONTINUOUS_PRICING_SCHEDULER=1

# Seller order history: order sync, FIFO replay and purchase cost estimates.
SELLER_ORDER_HISTORY_WORKER=1

# The slab evidence queue and slab maintenance.
SLAB_EVIDENCE_WORKER=1

# Publication to Seller Portal. Dev never sets SELLER_PORTAL_WRITES_ENABLED, so the worker stays
# off here and planned publications stay planned.
PUBLICATION_WORKER=1

# Applies db/migrations as the server starts (npm run db:migrate applies the same files).
MIGRATE_ON_START=1
