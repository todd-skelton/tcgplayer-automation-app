# Copy this file to .env.development.local for development-only overrides.
# Dev should use the EasyPost test key.

EASYPOST_TEST_API_KEY=

# Dev's batch pricing jobs are priced by the Corten app's worker; Node's in-process worker stays off.
PRICING_WORKER=1

# Dev's continuous pricing batches are queued by the Corten app's scheduler. Node's scheduler
# (npm run start:continuous-pricing-scheduler, not started by npm run dev) stays off when this is
# in its environment too.
CONTINUOUS_PRICING_SCHEDULER=1

# Dev's seller order history (order sync, FIFO replay, purchase cost estimates) is kept by the
# Corten app's worker. Node's worker (npm run start:seller-order-history-worker, not started by
# npm run dev) stays off when this is in its environment too.
SELLER_ORDER_HISTORY_WORKER=1
