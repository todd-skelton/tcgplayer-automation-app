# Copy this file to .env.development.local for development-only overrides.
# Dev should use the EasyPost test key.

EASYPOST_TEST_API_KEY=

# Dev's batch pricing jobs are priced by the Corten app's worker; Node's in-process worker stays off.
PRICING_WORKER=1

# Dev's continuous pricing batches are queued by the Corten app's scheduler. Node's scheduler
# (npm run start:continuous-pricing-scheduler, not started by npm run dev) stays off when this is
# in its environment too.
CONTINUOUS_PRICING_SCHEDULER=1

# Dev's seller order history (order sync, FIFO replay, purchase cost estimates) is kept by the
# Corten app's worker. npm run dev then leaves Node's worker out, and the worker exits at once if
# started on its own (npm run start:seller-order-history-worker).
SELLER_ORDER_HISTORY_WORKER=1

# Dev's slab evidence queue and slab maintenance are the Corten app's worker's. Node's worker
# (npm run start:slab-evidence-worker, not started by npm run dev) exits at once when this is set.
SLAB_EVIDENCE_WORKER=1

# Publication to Seller Portal is the Corten app's worker's. Dev never sets
# SELLER_PORTAL_WRITES_ENABLED, so it stays off here and planned publications stay planned, as
# Node's worker leaves them. Node's worker exits at once when this is set.
PUBLICATION_WORKER=1
