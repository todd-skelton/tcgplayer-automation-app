  "$extensions": {
    "run.corten": {
      "breakpoints": {
        "sm": {
          "value": 40,
          "unit": "rem"
        },
        "md": {
          "value": 60,
          "unit": "rem"
        },
        "xl": {
          "value": 96,
          "unit": "rem"
        }
      },
      "utilities": {
        "display": {
          "property": "display",
          "values": {
            "block": "block",
            "flex": "flex",
            "grid": "grid",
            "none": "none"
          }
        },
        "items": {
          "property": "align-items",
          "values": {
            "start": "start",
            "center": "center",
            "baseline": "baseline"
          }
        },
        "justify": {
          "property": "justify-content",
          "values": {
            "start": "start",
            "between": "space-between",
            "end": "end"
          }
        },
        "flex": {
          "property": "flex-wrap",
          "values": {
            "wrap": "wrap",
            "nowrap": "nowrap"
          }
        },
        "gap": {
          "property": "gap",
          "group": "space"
        },
        "p": {
          "property": "padding",
          "group": "space"
        },
        "px": {
          "property": "padding-inline",
          "group": "space"
        },
        "py": {
          "property": "padding-block",
          "group": "space"
        },
        "mb": {
          "property": "margin-block-end",
          "group": "space"
        },
        "mx": {
          "property": "margin-inline",
          "values": {
            "0": "0",
            "auto": "auto"
          }
        },
        "max-w": {
          "property": "max-width",
          "values": {
            "page": "1400px",
            "prose": "40rem"
          }
        },
        "text": {
          "property": "font-size",
          "group": "font-size"
        },
        "weight": {
          "property": "font-weight",
          "values": {
            "normal": "400",
            "medium": "500",
            "semibold": "600",
            "bold": "700"
          }
        },
        "fg": {
          "property": "color",
          "group": "color"
        },
        "bg": {
          "property": "background-color",
          "group": "color"
        },
        "rounded": {
          "property": "border-radius",
          "group": "radius"
        },
        "shadow": {
          "property": "box-shadow",
          "group": "shadow"
        },
        "numeric": {
          "property": "font-variant-numeric",
          "values": {
            "tabular": "tabular-nums"
          }
        },
        "grow": {
          "property": "flex-grow",
          "values": {
            "1": "1"
          }
        }
