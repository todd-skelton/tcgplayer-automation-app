{
  "name": "tcgplayer-automation-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-host-start.mjs",
    "dev:docker": "docker compose up --build",
    "dev:host": "node scripts/dev-host-start.mjs",
    "dev:app": "node scripts/run-with-node-options.mjs react-router dev",
    "dev:down": "docker compose down",
    "dev:logs": "docker compose logs -f",
    "dev:db": "docker compose exec postgres psql -U postgres -d tcgplayer_automation",
    "dev:db:refresh": "node scripts/dev-db-refresh.mjs",
    "test": "tsx app/test/run-tests.ts",
    "pricing:grade-forecasts": "tsx scripts/grade-forecasts.mts",
    "build": "node scripts/run-with-node-options.mjs react-router build && node scripts/build-workers.mjs",
    "start:pricing-worker": "node build/workers/pricing-worker.js",
    "start:publication-worker": "node build/workers/publication-worker.js",
    "start:continuous-pricing-scheduler": "node build/workers/continuous-pricing-scheduler.js",
    "start": "node scripts/run-with-node-options.mjs react-router-serve ./build/server/index.js",
    "typecheck": "node scripts/run-with-node-options.mjs react-router typegen && node scripts/run-with-node-options.mjs tsc",
    "db:migrate": "node scripts/db-migrate.mjs",
    "prod:deploy": "node scripts/prod.mjs deploy",
    "prod:update": "node scripts/prod.mjs update",
    "prod:start": "node scripts/prod.mjs start",
    "prod:stop": "node scripts/prod.mjs stop",
    "prod:restart": "node scripts/prod.mjs restart",
    "prod:logs": "node scripts/prod.mjs logs",
    "prod:status": "node scripts/prod.mjs status",
    "prod:shell": "node scripts/prod.mjs shell",
    "prod:clean": "node scripts/prod.mjs clean"
  },
  "dependencies": {
    "@easypost/api": "^8.8.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@mui/x-data-grid": "^8.28.2",
    "@react-router/node": "^7.18.3",
    "@react-router/serve": "^7.18.3",
    "axios": "^1.18.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "isbot": "^5.1.38",
    "p-limit": "^6.2.0",
    "papaparse": "^5.5.3",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.18.3"
  },
  "overrides": {
    "follow-redirects": "^1.15.12",
    "postcss": "^8.5.10",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@types/node": "^20.19.39",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.25.5",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
