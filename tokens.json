{
  "breakpoints": {
    "sm": "40rem",
    "md": "60rem",
    "xl": "96rem"
  },
  "scales": {
    "color": {
      "ink": "#1c1f26",
      "muted": "#5f6672",
      "line": "#e0e3e8",
      "bg": "#f5f6f8",
      "surface": "#ffffff",
      "raised": "#f0f2f5",
      "accent": "#1976d2",
      "accent-ink": "#ffffff",
      "bar": "#1976d2",
      "bar-ink": "#ffffff",
      "warn": "#b26a00",
      "warn-soft": "#fff4e5",
      "danger": "#c62828",
      "danger-soft": "#fdecea",
      "info": "#0b6bcb",
      "ok": "#2e7d32"
    },
    "space": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "24px",
      "6": "32px",
      "8": "48px"
    },
    "radius": {
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "pill": "999px"
    },
    "font-size": {
      "xs": "12px",
      "sm": "13px",
      "md": "15px",
      "lg": "18px",
      "xl": "24px",
      "2xl": "32px"
    },
    "shadow": {
      "sm": "0 1px 2px rgb(16 24 40 / 0.08)",
      "md": "0 1px 3px rgb(16 24 40 / 0.1), 0 6px 16px rgb(16 24 40 / 0.08)"
    }
  },
  "themes": {
    "[data-theme=\"dark\"]": {
      "@media": {
        "(prefers-color-scheme: dark)": ":root:not([data-theme=\"light\"])"
      },
      "color": {
        "ink": "#e8eaed",
        "muted": "#a0a6b0",
        "line": "#30343c",
        "bg": "#121212",
        "surface": "#1e1f22",
        "raised": "#26282c",
        "accent": "#90caf9",
        "accent-ink": "#0d1b2a",
        "bar": "#1e1f22",
        "bar-ink": "#ffffff",
        "warn": "#ffb74d",
        "warn-soft": "#2b2112",
        "danger": "#ef9a9a",
        "danger-soft": "#2c1616",
        "info": "#90caf9",
        "ok": "#81c784"
      }
    }
  },
  "utilities": {
    "display": { "property": "display", "values": { "block": "block", "flex": "flex", "grid": "grid", "none": "none" } },
    "items": { "property": "align-items", "values": { "start": "start", "center": "center", "baseline": "baseline" } },
    "justify": { "property": "justify-content", "values": { "start": "start", "between": "space-between", "end": "end" } },
    "flex": { "property": "flex-wrap", "values": { "wrap": "wrap", "nowrap": "nowrap" } },
    "gap": { "property": "gap", "scale": "space" },
    "p": { "property": "padding", "scale": "space" },
    "px": { "property": "padding-inline", "scale": "space" },
    "py": { "property": "padding-block", "scale": "space" },
    "mb": { "property": "margin-block-end", "scale": "space" },
    "mx": { "property": "margin-inline", "values": { "0": "0", "auto": "auto" } },
    "max-w": { "property": "max-width", "values": { "page": "1400px", "prose": "40rem" } },
    "text": { "property": "font-size", "scale": "font-size" },
    "weight": { "property": "font-weight", "values": { "normal": "400", "medium": "500", "semibold": "600", "bold": "700" } },
    "fg": { "property": "color", "scale": "color" },
    "bg": { "property": "background-color", "scale": "color" },
    "rounded": { "property": "border-radius", "scale": "radius" },
    "shadow": { "property": "box-shadow", "scale": "shadow" },
    "numeric": { "property": "font-variant-numeric", "values": { "tabular": "tabular-nums" } },
    "grow": { "property": "flex-grow", "values": { "1": "1" } }
  }
}
